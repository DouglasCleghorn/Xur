FROM mirror.gcr.io/vllm/vllm-omni@sha256:4780186f168af96634917208596675439fa71cb5ed3440a30e8c21ca1defc451
USER root
# Preserve the upstream serving stack, including its intentionally selected
# Torch/CUDA/NCCL/protobuf versions. Audiotools' legacy protobuf<3.20 metadata
# is for training; it must not downgrade Omni's protobuf for codec inference.
RUN python3 -c 'import importlib.metadata as m,json; json.dump({d.metadata["Name"]:m.version(d.metadata["Name"]) for d in m.distributions()},open("/opt/xur-fish-base.json","w"))'
COPY requirements.lock /opt/xur-fish-requirements.lock
RUN python3 -m pip install --no-cache-dir --no-deps --no-build-isolation --require-hashes --report /opt/xur-fish-install.json -r /opt/xur-fish-requirements.lock \
 && python3 -c 'import importlib.metadata as m,json; before=json.load(open("/opt/xur-fish-base.json")); changed=[n for n,v in before.items() if m.version(n)!=v]; assert not changed, changed' \
 && OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python3 -c 'from vllm_omni.model_executor.models.fish_speech.dac_utils import build_dac_codec; build_dac_codec()' \
 && python3 -m pip freeze --all > /opt/xur-fish-packages.txt
