FROM mirror.gcr.io/vllm/vllm-omni@sha256:4780186f168af96634917208596675439fa71cb5ed3440a30e8c21ca1defc451
USER root
# Retain the base engine's Torch/CUDA/numpy versions. Fail on conflicting
# dependencies instead of allowing pip to replace the serving stack.
RUN python3 -m pip freeze --exclude-editable > /tmp/engine-constraints.txt
RUN python3 -m pip install --no-deps 'https://files.pythonhosted.org/packages/2a/e9/3d641f8ae5176808c8be9c3713deb663edece717a587a3eb7f10fed3cdd6/fish_speech-0.1.0-py3-none-any.whl#sha256=1ea6123c7b9a441bc48f296439ae0e987621b780f9314ff3eb5ad072ebe9e7ac'
# Install the codec's dependencies only, avoiding Fish's training/UI extras.
RUN python3 -m pip install --constraint /tmp/engine-constraints.txt --report /opt/xur-fish-install.json 'descript-audio-codec==1.0.0' 'descript-audiotools==0.7.2' 'hydra-core==1.3.7' \
 && python3 -c 'from vllm_omni.model_executor.models.fish_speech.dac_utils import build_dac_codec; build_dac_codec()' \
 && python3 -m pip freeze --all > /opt/xur-fish-packages.txt
