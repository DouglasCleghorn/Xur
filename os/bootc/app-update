#!/usr/bin/python3
"""Compatibility launcher for older agents and installers; logic lives in xurutil."""
import os,pathlib,sys
utility=pathlib.Path(__file__).resolve().with_name('xurutil')
if not utility.is_file():
    # Older installer media copied only this launcher into their recovery directory.
    # The new agent installs an independent native copy before reporting health.
    utility=pathlib.Path('/var/lib/xur/app/current/host/xurutil')
arguments=sys.argv[1:]
if arguments[:2]==['channel','local'] and len(arguments)==4:
    arguments=arguments[:3]+['--',arguments[3]]
os.execv(str(utility),[str(utility),'app-update',*arguments])
