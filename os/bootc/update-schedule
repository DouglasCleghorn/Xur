#!/usr/bin/python3
"""Scheduled update windows and notices around the bundled native OS updater."""
import contextlib, datetime, fcntl, json, os, pathlib, pwd, re, subprocess, sys, time

STATE = pathlib.Path('/var/lib/xur/updates')
CONFIG = pathlib.Path('/etc/xur/upstream.json')
CHANNEL = 'ghcr.io/ublue-os/bazzite-nvidia-open:stable'
DEFAULT_SCHEDULE = dict(time='03:00', days=list(range(7)), warningMinutes=15)
TIMER_OVERRIDE = pathlib.Path('/etc/systemd/system/xur-os-update.timer.d/schedule.conf')
PROGRAM = '/var/lib/xur/app/current/host/os-update'
UTILITY = str(pathlib.Path(__file__).resolve().with_name('xurutil'))

@contextlib.contextmanager
def settings_guard():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (STATE / 'settings.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield

def settings():
    value = read(STATE / 'settings.json', {'automatic': True})
    return {**value, 'schedule': value.get('schedule') or DEFAULT_SCHEDULE}

def validate_schedule(value):
    if not isinstance(value, dict) or not re.fullmatch(r'(?:[01][0-9]|2[0-3]):[0-5][0-9]', str(value.get('time', ''))):
        raise RuntimeError('Choose a time in HH:mm format')
    days = value.get('days')
    warning = value.get('warningMinutes', 15)
    if not isinstance(days, list) or not days or any(type(day) is not int or day not in range(7) for day in days):
        raise RuntimeError('Choose at least one day (Monday=0 through Sunday=6)')
    if type(warning) is not int or not 5 <= warning <= 120:
        raise RuntimeError('Advance notice must be between 5 and 120 minutes')
    return dict(time=value['time'], days=sorted(set(days)), warningMinutes=warning)

def occurrences(schedule, now):
    # mktime uses the host timezone and its DST rules, rather than a fixed UTC
    # offset. Ignore nonexistent spring-forward times; run fall-back times once.
    today = datetime.datetime.fromtimestamp(now).date()
    hour, minute = map(int, schedule['time'].split(':'))
    result = []
    for offset in range(-1, 9):
        date = today + datetime.timedelta(days=offset)
        if date.weekday() not in schedule['days']: continue
        candidates = []
        for dst in (0, 1, -1):
            stamp = time.mktime((date.year, date.month, date.day, hour, minute, 0, 0, 0, dst))
            local = datetime.datetime.fromtimestamp(stamp)
            if local.date() == date and (local.hour, local.minute) == (hour, minute): candidates.append(stamp)
        if candidates: result.append(min(candidates))
    return result

def next_window(config, now):
    if not config['automatic']: return None
    window = read(STATE / 'window.json', {})
    return next((stamp for stamp in occurrences(config['schedule'], now)
                 if stamp > now and str(int(stamp)) != window.get('id')), None)

def active_window(config, now):
    window = read(STATE / 'window.json')
    return window if config['automatic'] and window and window['state'] == 'Waiting' and now <= window['startsAt'] + 120 else None

def configure(action, request):
    # This lock is independent of deployment work, so a skip never waits behind
    # a download. Moving Waiting -> Running under this same lock closes the race.
    with settings_guard():
        config = settings()
        if action == 'skip':
            window = active_window(config, time.time())
            if not window or window['id'] != request.get('windowId'):
                raise RuntimeError('This update window has ended or changed. Refresh status')
            window['state'] = 'Skipped'
            save(STATE / 'window.json', window)
            return
        if action == 'schedule': config['schedule'] = validate_schedule(request.get('schedule'))
        else: config['automatic'] = action == 'enable'
        save(STATE / 'settings.json', config)
        window = read(STATE / 'window.json')
        if window and window['state'] in ('Checking', 'Waiting'):
            window['state'] = 'Cancelled'
            save(STATE / 'window.json', window)

def initialize_timer():
    # Existing installations retain their persistent units across app updates.
    # Upgrade the legacy daily timer without requiring an OS image replacement.
    value = '[Timer]\nOnBootSec=\nOnBootSec=1min\nOnUnitActiveSec=\nOnUnitInactiveSec=\nOnUnitInactiveSec=1min\nRandomizedDelaySec=0\nAccuracySec=1s\n'
    if TIMER_OVERRIDE.exists() and TIMER_OVERRIDE.read_text() == value: return
    TIMER_OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
    TIMER_OVERRIDE.write_text(value)
    try:
        subprocess.run(['systemctl', 'daemon-reload'], check=True, timeout=15)
        subprocess.run(['systemctl', 'restart', 'xur-os-update.timer'], check=True, timeout=15)
    except Exception:
        TIMER_OVERRIDE.unlink(missing_ok=True)
        raise

def workstation_users():
    units = subprocess.check_output(['systemctl', 'list-units', '--state=active', '--no-legend', '--plain', 'xur-station-*.service'], text=True, timeout=10)
    users = {}
    for line in units.splitlines():
        unit = line.split()[0]
        if not re.fullmatch(r'xur-station-[a-zA-Z0-9_-]+\.service', unit): continue
        name = subprocess.check_output(['systemctl', 'show', unit, '--property=User', '--value'], text=True, timeout=5).strip()
        account = pwd.getpwnam(name)
        if 1000 <= account.pw_uid < 65534 and account.pw_dir == '/var/home/' + name:
            users[account.pw_uid] = account
    return users

def notify_workstations(window):
    # Each root-owned notice service interprets only the Skip response from one
    # unprivileged desktop process. No credentials or root-writable files are
    # exposed to the workstation user, and new stations are noticed on each tick.
    try:
        for uid in workstation_users():
            if uid in window.get('notified', []): continue
            result = subprocess.run(['systemd-run', '--quiet', '--collect', '--unit=xur-update-notice-' + window['id'] + '-' + str(uid),
                '--property=RuntimeMaxSec=' + str(max(1, int(window['startsAt'] - time.time()) + 120)),
                PROGRAM, 'notify', window['id'], str(uid)], capture_output=True, text=True, timeout=10)
            if result.returncode != 0:
                # An existing notice service is expected while --wait is active.
                continue
    except (OSError, KeyError, subprocess.SubprocessError) as error:
        print('Workstation update notice: ' + str(error), file=sys.stderr)

def desktop_notice(window_id, uid):
    window = active_window(settings(), time.time())
    if not window or window['id'] != window_id: return
    account = workstation_users().get(uid)
    if account is None: return
    runtime = '/run/user/' + str(uid)
    environment = subprocess.check_output(['runuser', '-u', account.pw_name, '--', 'env', 'XDG_RUNTIME_DIR=' + runtime,
        'DBUS_SESSION_BUS_ADDRESS=unix:path=' + runtime + '/bus', 'systemctl', '--user', 'show-environment'], text=True, timeout=10)
    wayland = next((line[16:] for line in environment.splitlines() if line.startswith('WAYLAND_DISPLAY=')), '')
    if not re.fullmatch(r'[a-zA-Z0-9_-]+', wayland): return
    seconds = max(1, int(window['startsAt'] - time.time()))
    message = 'OS update ' + window['version'] + ' will be staged at ' + time.strftime('%H:%M %Z', time.localtime(window['startsAt'])) + '. Reboot remains manual.'
    args = ['systemd-run', '--quiet', '--wait', '--pipe', '--collect', '--unit=xur-update-dialog-' + window_id + '-' + str(uid),
        '--property=User=' + account.pw_name, '--property=Slice=user-' + str(uid) + '.slice', '--property=NoNewPrivileges=true',
        '--property=RuntimeMaxSec=' + str(seconds), '--setenv=HOME=' + account.pw_dir, '--setenv=XDG_RUNTIME_DIR=' + runtime,
        '--setenv=DBUS_SESSION_BUS_ADDRESS=unix:path=' + runtime + '/bus', '--setenv=WAYLAND_DISPLAY=' + wayland,
        '/usr/bin/notify-send', '--app-name=Xur', '--urgency=normal', '--transient', '--wait', '--expire-time=' + str(seconds * 1000),
        '--action=skip=Skip this window', 'Automatic update approaching', message]
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=seconds + 10)
        if result.returncode == 0:
            if result.stdout.strip() == 'skip': configure('skip', {'windowId': window_id})
            with settings_guard():
                current = read(STATE / 'window.json', {})
                if current.get('id') == window_id and current.get('state') == 'Waiting':
                    current['notified'] = sorted(set(current.get('notified', []) + [uid]))
                    save(STATE / 'window.json', current)
        else: print('Workstation update notice could not be delivered: ' + result.stderr.strip(), file=sys.stderr)
    except subprocess.TimeoutExpired: pass

def read(path, default=None):
    return json.loads(path.read_text()) if path.exists() else default

def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temp = path.with_suffix('.tmp')
    with temp.open('w') as stream:
        json.dump(value, stream)
        stream.flush()
        os.fsync(stream.fileno())
    temp.replace(path)

def native(action):
    result = subprocess.run([UTILITY, 'os-update', action], capture_output=True, text=True,
                            timeout=35 if action == 'status' else 650 if action == 'check' else 7200)
    if result.returncode != 0:
        try: message = json.loads(result.stderr).get('error')
        except (ValueError, AttributeError): message = None
        raise RuntimeError(message or 'Native OS update operation failed. Review the update log')
    return json.loads(result.stdout) if action == 'status' else None

def operation_busy():
    if not (STATE / 'lock').exists(): return False
    with (STATE / 'lock').open('r') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except BlockingIOError: return True

def observe():
    result = native('status')
    with settings_guard():
        config = settings()
        now = time.time()
        window = active_window(config, now)
        if window and (result['pending'] or result['rollbackQueued']):
            window['state'] = 'Cancelled'
            save(STATE / 'window.json', window)
            window = None
        result.update(automatic=config['automatic'], schedule=config['schedule'], window=window,
                      nextWindow=next_window(config, now), timezone=time.strftime('%Z (%z)', time.localtime(now)))
    return result

def automatic():
    if operation_busy(): return
    with settings_guard():
        config = settings()
        if not config['automatic']: return
        window = read(STATE / 'window.json', {})
        now = time.time()
        if window.get('state') == 'Waiting':
            if now > window['startsAt'] + 120:
                window['state'] = 'Missed'
                save(STATE / 'window.json', window)
                return
            if now >= window['startsAt']:
                window['state'] = 'Running'
                save(STATE / 'window.json', window)
        else:
            scheduled = next((stamp for stamp in occurrences(config['schedule'], now)
                if now - 60 <= stamp <= now + config['schedule']['warningMinutes'] * 60 and str(int(stamp)) != window.get('id')), None)
            if scheduled is None: return
            window = dict(id=str(int(scheduled)), scheduledAt=scheduled, state='Checking')
            save(STATE / 'window.json', window)
    if window['state'] == 'Waiting':
        notify_workstations(window)
        return
    try:
        before = native('status')
        if not before['current'] or before['current']['image'] != CHANNEL:
            raise RuntimeError('The booted deployment does not track the configured upstream channel')
        if before['pending'] or before['rollbackQueued']:
            window['state'] = 'Cancelled'
            with settings_guard(): save(STATE / 'window.json', window)
            return
        automatic_operation(window, config)
    except Exception as error:
        with settings_guard():
            current = read(STATE / 'window.json', {})
            if current.get('id') == window['id'] and current.get('state') in ('Checking', 'Running'):
                current.update(state='Failed', message=str(error))
                save(STATE / 'window.json', current)
        raise

def automatic_operation(window, config):
    if window['state'] == 'Running':
        native('stage')
        with settings_guard():
            window['state'] = 'Complete'
            save(STATE / 'window.json', window)
        return
    native('check')
    after = native('status')
    with settings_guard():
        # A pause or changed schedule during the check must not resurrect the
        # old window. Always leave a full warning after the native check finishes.
        current = read(STATE / 'window.json', {})
        if settings() != config or current.get('id') != window['id'] or current.get('state') != 'Checking': return
        if after['pending'] or after['rollbackQueued'] or not after['available'] or after['available']['digest'] == after['current']['digest']:
            window['state'] = 'UpToDate'
        else:
            window.update(state='Waiting', startsAt=max(window['scheduledAt'], time.time() + config['schedule']['warningMinutes'] * 60),
                          version=after['available']['version'], notified=[])
        save(STATE / 'window.json', window)
    if window['state'] == 'Waiting': notify_workstations(window)

def main():
    if os.geteuid() != 0: raise RuntimeError('Root is required')
    action = sys.argv[1] if len(sys.argv) >= 2 else ''
    if not pathlib.Path('/var/lib/xur/installed').exists(): raise RuntimeError('Updates are available after installation')
    if read(CONFIG, {}).get('channel') != CHANNEL: raise RuntimeError('Unsupported upstream update source')
    if action == 'status':
        print(json.dumps(observe())); return
    if action == 'initialize':
        initialize_timer(); return
    if action == 'notify' and len(sys.argv) == 4:
        desktop_notice(sys.argv[2], int(sys.argv[3])); return
    if action in ('schedule', 'skip', 'enable', 'disable'):
        configure(action, json.loads(sys.argv[2]) if len(sys.argv) == 3 else {})
        if action != 'skip': initialize_timer()
        return
    if action != 'auto': raise RuntimeError('Unknown scheduled update action')
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    # The scheduler lease must be separate from the native operation lease:
    # the native child owns lock/power.lock and its durable receipt.
    with (STATE / 'schedule-operation.lock').open('a') as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: return
        automatic()

if __name__ == '__main__':
    try: main()
    except Exception as error:
        print(json.dumps({'error': str(error)}), file=sys.stderr)
        sys.exit(1)
