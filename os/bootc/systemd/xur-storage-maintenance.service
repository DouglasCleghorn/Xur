[Unit]
Description=Reclaim unused Xur application and container storage
After=xur-app-prepare-recovery.service xur-app-recovery.service
ConditionPathExists=/var/lib/xur/installed
ConditionFileIsExecutable=/var/lib/xur/app/current/host/storage-maintenance

[Service]
Type=oneshot
ExecStart=/var/lib/xur/app/current/host/storage-maintenance
Nice=10
IOSchedulingClass=idle
UMask=0077
TimeoutStartSec=2h
