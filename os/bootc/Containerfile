ARG XUR_INSTALLER_BASE=quay.io/fedora/fedora-bootc:44
FROM ${XUR_INSTALLER_BASE} AS common
RUN dnf install -y podman pciutils usbutils util-linux NetworkManager NetworkManager-wifi wpa_supplicant linux-firmware iproute libicu openssl-libs firewalld && \
    firewall-offline-cmd --add-port=8080/tcp --add-port=8443/tcp && dnf clean all
# The installed host is the signed upstream image in upstream-lock.json.
# This build stage supplies only the separate live installer environment.
