#!/usr/bin/python3
"""Synchronize UTC and the RTC before Anaconda can read stale time or erase a disk."""
import datetime
import os
from pathlib import Path
import subprocess

class ClockError(RuntimeError):
    pass

def sync_clock(run=subprocess.run, has_rtc=None, now=lambda: datetime.datetime.now(datetime.timezone.utc)):
    def command(args, timeout, message):
        try:
            result = run(args, check=False, capture_output=True, text=True, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired) as error:
            raise ClockError(message) from error
        if result.returncode:
            raise ClockError(message)
        return result.stdout.strip()
    command(['systemctl', 'start', 'chronyd.service'], 15,
            'Time synchronization service could not start. Check chronyd and installer executable paths.')
    command(['chronyc', 'online'], 5, 'Could not bring the configured time sources online.')
    command(['chronyc', 'makestep', '0.1', '3'], 5, 'Could not enable correction of the system clock.')
    command(['chronyc', 'burst', '4/4'], 5, 'Could not request measurements from the time servers.')
    command(['chronyc', 'waitsync', '15', '1', '0', '2'], 35,
            'Time synchronization did not complete within 30 seconds. Check Ethernet/Wi-Fi, DNS and access to NTP servers (UDP 123).')
    if has_rtc is None:
        has_rtc = Path('/dev/rtc').exists() or any(Path('/dev').glob('rtc[0-9]*'))
    if has_rtc:
        command(['hwclock', '--systohc', '--utc'], 10,
                'Could not save synchronized UTC to the hardware clock. Anaconda would restore stale time.')
        value = command(['hwclock', '--show', '--utc'], 10, 'Could not verify the hardware clock.')
        try:
            rtc = datetime.datetime.fromisoformat(' '.join(value.split()[:2]))
            if rtc.tzinfo is None or abs((now() - rtc).total_seconds()) > 5:
                raise ValueError('Hardware clock differs from synchronized UTC')
        except (ValueError, TypeError) as error:
            raise ClockError('Hardware clock verification failed. Correct the RTC before starting installation.') from error
    print('System time synchronized' + (' and hardware clock verified in UTC.' if has_rtc else '; no hardware clock is present.'))

if __name__ == '__main__':
    os.umask(0o077)
    os.environ['LC_ALL']='C'
    os.environ['TZ']='UTC'
    try:
        sync_clock()
    except ClockError as error:
        message = str(error) + ' Installation stopped before disk erasure.'
        Path('/run/xur/install-error').write_text(message + '\n')
        raise SystemExit(message)
