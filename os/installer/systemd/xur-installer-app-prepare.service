[Unit]
Description=Select the bundled installer application
ConditionKernelCommandLine=xur.installer=1
After=local-fs.target
Before=xur-gateway.service xur-agent.service xur-control.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/xurutil installer prepare
TimeoutStartSec=140
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
