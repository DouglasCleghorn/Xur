#!/usr/bin/python3
"""Embed bootc's native terminal download progress in the installer console.

Only stderr receives a terminal; stdout, arguments, disk approval and the real
bootc exit status retain their usual Anaconda behavior. No downloads are retried.
"""
import codecs
import errno
import fcntl
import json
import os
import pathlib
import pty
import re
import signal
import struct
import subprocess
import sys
import termios

BOOTC = '/usr/bin/bootc'
STATUS = pathlib.Path('/run/xur/install-download.json')
ANSI = re.compile(r'\x1b\[[0-?]*[ -/]*[@-~]')
SIZE = r'\d+(?:\.\d+)?\s*(?:[KMGTPE]i?B|B)'
LAYERS = re.compile(r'Fetching layers\s+.*?\b(\d+)/(\d+)\b')
LAYER = re.compile(r'Fetching\s+.*?(' + SIZE + r')/(' + SIZE + r')\s+\((' + SIZE + r'/s)\)')


class Progress:
    def __init__(self, path=STATUS):
        self.path = path
        self.pending = ''
        self.native = None
        self.counts = None
        self.disabled = False

    def feed(self, text):
        self.pending += text
        # A draw can span reads, UTF-8 characters and escape sequences. Parse
        # only complete terminal lines; retain at most one bounded partial line.
        lines = re.split(r'[\r\n]', self.pending)
        self.pending = lines.pop()[-4096:]
        for line in lines:
            self.line(ANSI.sub('', line).strip())

    def line(self, line):
        layers = LAYERS.search(line)
        if layers:
            completed, total = map(int, layers.groups())
            if 0 <= completed <= total <= 1000000 and total > 0:
                if self.counts != (completed, total):
                    self.native = {}
                    self.counts = (completed, total)
                self.native['layerProgress'] = line[:512]
                self.write()
            return
        layer = LAYER.search(line)
        if layer:
            if self.native is not None and self.counts[0] < self.counts[1]:
                self.native['byteProgress'] = line[:512]
                self.write()
            return
        if line:
            # Keep installer failures and ordinary stderr in Anaconda's logs,
            # without filling them with terminal redraws.
            print(line, file=sys.stderr, flush=True)

    def write(self):
        if self.disabled:
            return
        try:
            temp = self.path.with_suffix('.tmp')
            temp.write_text(json.dumps(self.native) + '\n')
            temp.replace(self.path)
        except OSError:
            # Progress reporting must never turn a successful install into a
            # failure or cause an approved disk installation to be repeated.
            self.disabled = True
            print('Download counters could not be saved; stage progress remains available.', file=sys.stderr, flush=True)


def run(args):
    if args[:2] != ['install', 'to-filesystem']:
        os.execv(BOOTC, [BOOTC, *args])
    master = slave = -1
    try:
        master, slave = pty.openpty()
        # Avoid clipping the counters or layer identifiers on the private tty.
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 240, 0, 0))
    except OSError:
        for descriptor in (master, slave):
            if descriptor != -1:
                os.close(descriptor)
        os.execv(BOOTC, [BOOTC, *args])
    try:
        with subprocess.Popen([BOOTC, *args], stderr=slave, env={**os.environ, 'TERM': 'xterm', 'LC_ALL': 'C'}) as process:
            os.close(slave)
            slave = -1
            # Anaconda cancellation reaches the original bootc process too.
            for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                signal.signal(sig, lambda number, frame: process.send_signal(number))
            progress = Progress()
            decoder = codecs.getincrementaldecoder('utf-8')('replace')
            while True:
                try:
                    chunk = os.read(master, 8192)
                except OSError as error:
                    if error.errno == errno.EIO:  # Last slave closed.
                        break
                    raise
                if not chunk:
                    break
                progress.feed(decoder.decode(chunk))
            progress.feed(decoder.decode(b'', final=True) + '\n')
            result = process.wait()
        if result < 0:
            signal.signal(-result, signal.SIG_DFL)
            os.kill(os.getpid(), -result)
        return result
    finally:
        os.close(master)
        if slave != -1:
            os.close(slave)


if __name__ == '__main__':
    os.umask(0o077)
    sys.exit(run(sys.argv[1:]))
