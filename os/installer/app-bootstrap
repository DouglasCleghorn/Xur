#!/usr/bin/python3
"""Start bundled Xur locally; check signed updates without interrupting setup."""
import hashlib,importlib.machinery,importlib.util,json,os,pathlib,shutil,signal,sys,tempfile
ROOT=pathlib.Path('/run/xur/app')
BUNDLED=pathlib.Path('/usr/share/xur/app-bundle')
READY=pathlib.Path('/run/xur/installer-app-ready')
CHANNEL=pathlib.Path('/usr/share/xur/installer-channel')
CMDLINE=pathlib.Path('/proc/cmdline')
APPROVED=pathlib.Path('/run/xur/approved.ks')
CHECK_SECONDS=15
def mode():
    args=CMDLINE.read_text().split()
    if 'xur.app-update=off' in args:return 'off'
    return 'on' if 'xur.app-update=on' in args else 'background'
def status(state):
    ROOT.mkdir(parents=True,exist_ok=True)
    target=ROOT/'check.json';temp=ROOT/'check.json.tmp'
    temp.write_text(json.dumps({'state':state})+'\n');temp.replace(target)
def select(path):
    ROOT.mkdir(parents=True,exist_ok=True)
    link=ROOT/'next';link.unlink(missing_ok=True);link.symlink_to(path);link.replace(ROOT/'current')
def updater():
    loader=importlib.machinery.SourceFileLoader('xur_updater',str(BUNDLED/'host/app-update'))
    spec=importlib.util.spec_from_loader(loader.name,loader);u=importlib.util.module_from_spec(spec);loader.exec_module(u)
    u.ROOT=ROOT;u.CONFIG=pathlib.Path('/run/xur/application-updates.json');u.KEY=pathlib.Path('/usr/share/xur/application-update-key.pem')
    selected=CHANNEL.read_text().strip() if CHANNEL.exists() else 'stable'
    u.select_channel(selected)
    return u
def prepare():
    select(BUNDLED);READY.unlink(missing_ok=True)
    selected=mode();status('disabled' if selected=='off' else 'pending')
    # Default boot has no network calls. Service health, not internet access,
    # controls disk approval. Never replace the running setup in the background.
    if selected!='on':return
    status('refreshing')
    refresh()
def initialize(u):
    floor=max(u.read(BUNDLED/'bundle.json').get('buildSequence',0),u.read(ROOT/'current/bundle.json').get('buildSequence',0),u.read(ROOT/'highest-sequence.json',0))
    u.atomic(ROOT/'highest-sequence.json',floor)
    sequences=u.read(ROOT/'channel-sequences.json',{});sequences[u.channel()]=max(sequences.get(u.channel(),0),floor)
    u.atomic(ROOT/'channel-sequences.json',sequences)
def check():
    if mode()=='off':status('disabled');return
    if APPROVED.exists():return
    def expired(*args):raise TimeoutError('Installer update check timed out')
    previous=signal.signal(signal.SIGALRM,expired);signal.alarm(CHECK_SECONDS)
    try:
        status('checking');u=updater();initialize(u)
        with tempfile.TemporaryDirectory(prefix='check-',dir=ROOT) as directory:
            entry=u.check(pathlib.Path(directory))
            identity=u.read(ROOT/'current/bundle.json')['id']
            status('current' if entry['id']==identity else 'available')
    except Exception:
        status('unavailable')
    finally:signal.alarm(0);signal.signal(signal.SIGALRM,previous)
def refresh():
    u=updater()
    initialize(u)
    def expired(*args):raise TimeoutError('Installer refresh deadline exceeded')
    signal.signal(signal.SIGALRM,expired);signal.alarm(120)
    try:
        with tempfile.TemporaryDirectory(prefix='download-',dir=ROOT) as directory:
            stage=pathlib.Path(directory);entry=u.check(stage)
            if entry['id']==u.read(BUNDLED/'bundle.json')['id']:status('current');return
            # This contract covers the live paths, approval API and installer hooks.
            # Older signed releases without it must not replace an installer app.
            archive=stage/'bundle.tar.gz';u.fetch((stage/'source').read_text()+'/'+entry['file'],archive,entry['bytes'])
            if archive.stat().st_size!=entry['bytes'] or hashlib.file_digest(archive.open('rb'),'sha256').hexdigest()!=entry['sha256']:raise ValueError('Download hash mismatch')
            u.unpack(archive,stage/'bundle',entry)
            if 'online-installer-v1' not in u.read(stage/'bundle/host/application-features.json',[]):raise ValueError('Release does not support this installer')
            releases=ROOT/'releases';releases.mkdir(exist_ok=True);target=releases/entry['id']
            if target.exists():shutil.rmtree(target)
            (stage/'bundle').rename(target)
            u.call(['restorecon','-RF',str(target)],30)
            u.atomic(ROOT/('release-'+entry['id']+'.json'),entry)
            select(target)
            status('current')
            print('Using signed Xur release '+entry['version'],flush=True)
    except Exception as error:
        select(BUNDLED);status('unavailable');print('Keeping bundled Xur: '+str(error),flush=True)
    finally:signal.alarm(0)
def verify():
    u=updater();identity=u.read(ROOT/'current/bundle.json')['id']
    if not u.healthy(identity,45):
        if APPROVED.exists():raise RuntimeError('Installation already approved; refusing app replacement')
        u.call(['systemctl','stop',*u.SERVICES],60);select(BUNDLED)
        u.call(['systemctl','start','xur-gateway','xur-agent','xur-control'],60)
        if not u.healthy(u.read(BUNDLED/'bundle.json')['id'],45):raise RuntimeError('Bundled installer app health check failed')
        status('fallback')
    READY.touch(mode=0o600)
if __name__=='__main__':
    os.umask(0o077)
    {'prepare':prepare,'verify':verify,'check':check}[sys.argv[1]]()
