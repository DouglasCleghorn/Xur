<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Avoid the SDK 10 Razor generator regression: dotnet/razor#13184.
       Compile Razor with the SDK's non-generator pipeline instead. -->
  <PropertyGroup>
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <DefaultItemExcludes>$(DefaultItemExcludes);.build/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Xur.Domain/Xur.Domain.csproj" />
    <ProjectReference Include="../../tools/Xur.Cli/Xur.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
  <!-- LibMan restores into ignored .build/; include its output before the
       SDK discovers static web assets so clean builds and publishes ship it. -->
  <Target Name="IncludeClientLibraries" BeforeTargets="AssignTargetPaths;ResolveProjectStaticWebAssets" DependsOnTargets="LibraryManagerRestore">
    <ItemGroup>
      <Content Include=".build/libman/ag-grid/dist/ag-grid-community.min.js"
               Link="wwwroot/vendor/ag-grid/ag-grid-community.min.js"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include=".build/libman/ag-grid/LICENSE.txt"
               Link="wwwroot/vendor/ag-grid/LICENSE.txt"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
