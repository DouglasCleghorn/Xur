@page "/storage"
@inject Appliance Device
@inject ProfileManager Profiles
<PageTitle>Storage · Xur</PageTitle>
<div class="page-heading"><h1>Storage</h1>@if(!Device.Installer) { <form method="post" action="/storage/refresh"><AntiforgeryToken /><button class="secondary" disabled="@(usage?.Scanning==true)">Refresh usage</button></form> }</div>
@if(Device.Installer) { <p>Storage usage is available after installation.</p> }
else if(usage==null) { <p role="alert">Storage usage is unavailable.</p> }
else
{
    @if(TrimStarted) { <p class="notice" role="status">TRIM started. Its result appears below when it finishes.</p> }
    @if(usage.Error!=null) { <p class="notice error" role="alert">@usage.Error</p> }
    @if(usage.TelemetryError!=null) { <p class="notice error" role="alert">@usage.TelemetryError</p> }
    <p class="secondary-text" role="status">@(usage.Scanning?"Calculating storage usage…":usage.CapturedAt is {} captured?"Updated "+captured.ToLocalTime().ToString("HH:mm:ss"):"Waiting for storage usage")</p>
    <section class="panel" id="data-storage" aria-labelledby="data-storage-heading">
        <h2 id="data-storage-heading">Workload storage</h2>
        <p>Choose where large model files, Unsloth downloads, datasets and training outputs live. Xur configuration stays on the system disk.</p>
        <p class="secondary-text">Moving unloads the current profile, copies and verifies the data, then reloads the profile while this page is open. Originals are retained. Keep space for downloads and temporary files; no cache or training output is automatically deleted.</p>
        @if(locations==null) { <p role="alert">Storage locations are unavailable.</p> }
        else
        {
            @foreach(var id in new[]{"default","models","unsloth"})
            {
                var group=locations.Groups.FirstOrDefault(g=>g.Id==id);
                var selected=group?.Selection??locations.DefaultSelection;
                <form method="post" class="storage-location-form" data-group="@id">
                    <AntiforgeryToken />
                    <label for="@("storage-"+id)">@(group?.Name??"Default data drive")</label>
                    <select id="@("storage-"+id)" name="destination" disabled="@locations.Busy">
                        @if(id!="default") { <option value="inherit" selected="@(selected=="inherit")">Use default data drive</option> }
                        <option value="system" selected="@(selected=="system")">System disk</option>
                        @foreach(var drive in locations.Drives)
                        { <option value="@drive.Uuid" selected="@(selected==drive.Uuid)">@drive.Source · @Size(drive.Available) free · @drive.Path</option> }
                        @if(selected is not ("system" or "inherit") && !locations.Drives.Any(d=>d.Uuid==selected))
                        { <option value="@selected" selected>Unavailable drive · @selected</option> }
                    </select>
                    <button type="submit" disabled="@locations.Busy">Unload profile and move</button>
                    @if(group!=null)
                    {
                        @if(group.Error!=null) { <p role="alert">@group.Error</p> }
                        else if(group.Available is {} free) { <p>@Size(free) available</p> }
                        <details><summary>Current folders</summary>@foreach(var path in group.Paths) { <code class="mount-path">@path</code> }</details>
                    }
                </form>
            }
            <p role="status" id="storage-move-status">@(locations.Job?.Message??"Select an existing ext4 or XFS data drive. Drives are identified by UUID; an unavailable drive blocks startup instead of filling the system disk.")</p>
            @if(locations.Job is {} job)
            {
                <details><summary>@job.Stage · Retained originals</summary>@foreach(var path in job.RetainedPaths) { <code class="mount-path">@path</code> }</details>
            }
            <script src="/storage-locations.js" defer></script>
        }
    </section>
    <section aria-labelledby="storage-devices">
        <h2 id="storage-devices">Disks &amp; mounts</h2>
        <div class="storage-table-scroll" role="region" aria-label="Disk and mount details" tabindex="0">
        <table class="storage-table" aria-describedby="storage-endurance-note">
            <thead><tr><th scope="col">Disk</th><th scope="col">Filesystem &amp; mounts</th><th scope="col">Space</th><th scope="col">Write endurance remaining</th></tr></thead>
            <tbody>
            @foreach(var row in StorageUsageRow.Build(usage))
            {
                <tr>
                    <td>
                        @foreach(var disk in row.Disks)
                        {
                            <div class="storage-device"><strong>@(disk.Model.Length==0?disk.Path:disk.Model)</strong><code class="mount-path">@disk.Path</code><span class="secondary-text">@Size(disk.Bytes) disk</span></div>
                        }
                        @if(row.Disks.Length==0) { <span class="secondary-text">Backing disk unavailable</span> }
                    </td>
                    <td>
                        @if(row.Filesystem is {} fs)
                        {
                            <strong>@fs.Type</strong><code class="mount-path">@fs.Source</code>
                            @foreach(var mount in fs.Mounts.Take(2)) { <code class="mount-path">@mount</code> }
                            @if(fs.Mounts.Length>2)
                            {
                                <details><summary>@(fs.Mounts.Length-2) more mounts</summary>@foreach(var mount in fs.Mounts.Skip(2)) { <code class="mount-path">@mount</code> }</details>
                            }
                        }
                        else
                        {
                            <span class="secondary-text">@(row.Disks.Any(d=>d.Mounts.Length>0)?"Filesystem usage unavailable":"No mounted filesystem")</span>
                            @foreach(var mount in row.Disks.SelectMany(d=>d.Mounts).Distinct()) { <code class="mount-path">@mount</code> }
                        }
                    </td>
                    <td>
                        @if(row.Filesystem is {} space)
                        {
                            <div class="storage-space"><strong>@Size(space.Used) used</strong><span class="secondary-text">of @Size(space.Bytes)</span>
                            <meter min="0" max="@space.Bytes" value="@space.Used" aria-label="@("Used space on "+space.Source)">@Size(space.Used)</meter>
                            <span>@Size(space.Available) available</span></div>
                        }
                        else { <span class="secondary-text">Unavailable</span> }
                    </td>
                    <td>
                        @foreach(var disk in row.Disks.Where(d=>d.Endurance?.RemainingPercent!=null || d.Endurance?.RemainingBytes!=null))
                        {
                            <div class="storage-endurance">
                            @if(row.Disks.Length>1) { <code class="mount-path">@disk.Path</code> }
                            @if(disk.Endurance?.RemainingPercent is {} remaining)
                            {
                                <strong>@remaining.ToString("0.#")% remaining</strong>
                            }
                            @if(disk.Endurance?.RemainingBytes is {} bytes) { <span>@Size(bytes) remaining</span> }
                            </div>
                        }
                    </td>
                </tr>
            }
            @if(usage.Disks.Length==0 && usage.Filesystems.Length==0) { <tr><td colspan="4">No disks or mounted filesystems reported.</td></tr> }
            </tbody>
        </table>
        </div>
        <p id="storage-endurance-note" class="secondary-text storage-note">Endurance reflects the drive’s reported wear. Remaining bytes are shown only when reported by the drive; no byte budget is extrapolated. Shared filesystems appear once with their observed backing disks.</p>
    </section>
    <section class="panel" aria-labelledby="trim-heading"><div class="section-heading"><h2 id="trim-heading">SSD TRIM</h2><a href="/storage">Refresh status</a></div>
    @if(trim==null) { <p>TRIM status unavailable.</p> } else {
        <p>Scheduled TRIM: <strong>@(trim.Timer.Split('\n').Contains("ActiveState=active")?"Enabled":"Not active")</strong></p>
        <p class="secondary-text">TRIM returns unused filesystem blocks to the SSD; it does not delete files or increase free space. Filesystem and controller support is checked when it runs.</p>
        @foreach(var mount in trim.Mounts.Where(m=>m.Ssd).GroupBy(m=>string.IsNullOrEmpty(m.Uuid)?m.Source.Split('[')[0]:m.Uuid).Select(g=>g.OrderByDescending(m=>m.TrimSupported).First())) {
            var last=trim.Results.FirstOrDefault(r=>trim.Mounts.Any(m=>m.Id==r.Id&&m.Source.Split('[')[0]==mount.Source.Split('[')[0]));
            <article class="storage-disk-row trim-row"><div><strong>@mount.Path</strong><span class="secondary-text">@mount.Source</span></div><span>@(mount.ReadOnly?"Read only":mount.TrimSupported?"Discard supported":"Discard unavailable")</span>
            @if(mount.TrimSupported) { <form method="post" action="/storage/trim"><AntiforgeryToken /><input type="hidden" name="id" value="@mount.Id" /><button class="secondary" disabled="@trim.Busy">Trim SSD</button></form> }
            @if(last!=null) { <p class="trim-result" role="status">@(last.Success==true?"Completed":last.Success==false?"Failed":"Running") · @(last.FinishedAt?.ToLocalTime().ToString("g")) · @last.Message</p> }
            else { <span class="secondary-text trim-result">No manual TRIM recorded</span> }
            </article>
        }
        @if(!trim.Mounts.Any(m=>m.Ssd)) { <p>No mounted SSDs reported.</p> }
        <details><summary>Scheduled TRIM</summary><pre>@trim.Timer
@trim.LastScheduledRun</pre></details>
        @if(trim.Busy) { <p role="status">TRIM is running. This page refreshes when it finishes.</p><script src="/trim-status.js" defer></script> }
    }
    @if(TrimError) { <p role="alert">TRIM could not start. Another operation may be running or the storage device changed. Refresh and try again.</p> }
    </section>
    <section class="storage-breakdown" aria-labelledby="folder-usage"><div class="section-heading"><h2 id="folder-usage">Folder usage</h2></div>
        @foreach(var category in usage.Categories)
        {
            <article class="storage-usage-row"><div><strong>@category.Name</strong><details><summary>Locations</summary>@foreach(var path in category.Paths) { <code class="mount-path">@path</code> }</details></div>
                <div class="storage-category-bar" aria-hidden="true"><span style="@("width:"+Percent(category.Bytes)+"%")"></span></div><span class="storage-size">@(category.Bytes is {} bytes?Size(bytes):category.Error)</span></article>
        }
        <p class="secondary-text storage-note">Folder totals can differ from filesystem usage because of shared data, snapshots, and filesystem metadata. Models includes Xur downloads and persistent model engine caches. Those caches are excluded from Containers &amp; engines. Model folders elsewhere remain in their containing category.</p>
    </section>
    <section aria-labelledby="persistent-volumes"><h2 id="persistent-volumes">Persistent volumes</h2>
        @foreach(var volume in usage.Volumes??[])
        {
            <article class="storage-usage-row"><div><strong>@volume.Name</strong><details><summary>Location</summary><code class="mount-path">@volume.Path</code></details></div>
                <span>@VolumeUsers(volume.Id)</span><span>@(volume.Bytes is {} bytes?Size(bytes):"Measuring…")</span></article>
        }
        @if(usage.Volumes is not {Length:>0}) { <p>No persistent container volumes.</p> }
    </section>
    <script src="/storage-usage.js" defer data-scanning="@usage.Scanning.ToString().ToLowerInvariant()"></script>
}
@code {
    [SupplyParameterFromQuery] public bool TrimStarted {get;set;}
    [SupplyParameterFromQuery] public bool TrimError {get;set;}
    TrimStatus? trim;StorageUsageSnapshot? usage;ProfileState? profiles;DataStorageStatus? locations;
    string VolumeUsers(string id)=>string.Join(", ",profiles?.Profiles.SelectMany(p=>p.Workloads).Where(w=>w.Recipe.Container?.Mounts.Any(m=>m.Volume==id)==true).Select(w=>w.Name).Distinct()??[]);
    static string Size(decimal bytes)
    {
        string[] units=["B","KiB","MiB","GiB","TiB","PiB","EiB","ZiB","YiB"];var unit=0;
        while(bytes>=1024 && unit<units.Length-1){bytes/=1024;unit++;}
        return $"{bytes:0.#} {units[unit]}";
    }
    string Percent(long? bytes)=>(100d*(bytes??0)/Math.Max(1,usage!.Categories.Max(c=>c.Bytes??0))).ToString("0.0",System.Globalization.CultureInfo.InvariantCulture);
    protected override async Task OnInitializedAsync()
    {
        if(Device.Installer)return;
        async Task Usage(){try{usage=await Device.Agent.GetFromJsonAsync<StorageUsageSnapshot>("/storage-usage");}catch{}}
        async Task ProfilesRead(){try{profiles=await Profiles.State();}catch{}}
        async Task TrimRead(){try{trim=await Device.Agent.GetFromJsonAsync<TrimStatus>("/storage/trim");}catch{}}
        async Task Locations(){try{locations=await Device.Agent.GetFromJsonAsync<DataStorageStatus>("/storage/locations");}catch{}}
        await Task.WhenAll(Usage(),ProfilesRead(),TrimRead(),Locations());
    }
}
