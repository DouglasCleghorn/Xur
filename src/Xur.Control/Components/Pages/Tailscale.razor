@page "/tailscale"
@inject Appliance Device
<PageTitle>Tailscale · Xur</PageTitle>
<script src="/page-poll.js" data-path="/api/page-state/tailscale" data-version="@PagePolling.Tailscale(Device)" defer></script>
<h1>Tailscale</h1>
<section class="panel">
    @if(Device.EnrollmentError.Length>0&&serverName is not {Configured:true}) { <p role="alert">@Device.EnrollmentError</p> }
    @if(serverName is not {Configured:true})
    {
        <p>Choose and save this server's name before setting up Tailscale.</p>
        <form method="post" action="/settings/computer-name"><AntiforgeryToken /><label>Server name <input name="name" value="@serverName?.Name" maxlength="63" required /></label><button>Save server name</button></form>
    }
    <p>@Device.TailscaleState</p>
    <p role="status">@Device.TailServeStatus</p>
    @if(Device.TailscaleState=="Running"&&!Device.TailServeReady) { <p><a href="https://login.tailscale.com/admin/dns" target="_blank" rel="noopener noreferrer">Open Tailscale DNS / HTTPS settings</a>. Xur retries the HTTPS proxy automatically.</p> }
    @if(Device.TailscaleState != "Running")
    {
        @if(Device.TailLoginUrl is { Length: >0 } loginUrl)
        {
            <a class="button" href="@loginUrl" target="_blank" rel="noopener noreferrer">Authorize this machine</a>
        }
        else if(Device.QrRunning)
        {
            <p>Preparing Tailscale login…</p>
        }
        else if(serverName?.Configured==true)
        {
            <form method="post" action="/tailscale/start"><AntiforgeryToken /><button>Sign in to Tailscale</button></form>
        }
    }
    @if(Device.TailUrl.Length>0) { <p><a href="@Device.TailUrl">@Device.TailUrl</a></p> }
    @if(Device.TailscaleState == "Running" && Device.ConfirmedAdministrator == null)
    {
        <p>@Device.TailIdentity</p>
        <form method="post" action="/tailscale/confirm"><AntiforgeryToken /><button>Use this account to manage Xur</button></form>
    }
    @if(Device.ConfirmedAdministrator != null) { <p>@Device.ConfirmedAdministrator</p> }
</section>
@code {
    ComputerNameStatus? serverName;
    protected override async Task OnInitializedAsync(){await Device.RefreshTailscale();try{serverName=await Device.Agent.GetFromJsonAsync<ComputerNameStatus>("/computer-name");}catch{}}
}
