@page "/install/review"
@inject Appliance Device
<PageTitle>Install Xur</PageTitle>
<h1>Install Xur</h1>
@if(Device.Plan is not { } plan)
{
    <p><a href="/">Select a disk.</a></p>
}
else
{
    <section class="panel">
        <h2>@plan.Target.Model</h2>
        <p>@((plan.Target.Bytes/1073741824d).ToString("N1")) GiB · @plan.Target.Path · @plan.Target.Serial</p>
        <p>All data on this disk will be erased.</p>
        <details><summary>Installation layout</summary><ol>@foreach(var action in plan.Actions) { <li>@action</li> }</ol></details>
        <form method="post" action="/install/approve">
            <AntiforgeryToken />
            <input type="hidden" name="id" value="@plan.Id" />
            <input type="hidden" name="digest" value="@plan.Digest" />
            <button class="danger">Erase disk and install Xur</button>
            <a href="/">Choose another disk</a>
        </form>
    </section>
}
