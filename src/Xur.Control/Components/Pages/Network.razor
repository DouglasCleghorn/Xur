@page "/network"
@page "/settings"
@inject Appliance Device
@inject Bootstrap Auth
<PageTitle>Settings · Xur</PageTitle>

<h1>Settings</h1>
<p class="secondary-text">Xur is MIT-licensed open source. <a href="https://github.com/DouglasCleghorn/Xur">Source code</a> · <a href="https://github.com/DouglasCleghorn/Xur/blob/main/LICENSE">MIT license</a> · <a href="https://github.com/DouglasCleghorn/Xur/blob/main/docs/licensing.md">Third-party notices</a></p>
<section class="panel"><h2>API access</h2><p>Give scripts and assistants their own revocable credentials with optional expiration.</p><a class="button secondary" href="/settings/api-keys">Manage API keys</a></section>
@if(Auth.AccountConfigured) { <section class="panel"><h2>Account</h2><p>@Auth.Username</p><form method="post" action="/auth/logout"><AntiforgeryToken /><button class="secondary">Sign out</button></form></section> }
<section class="panel"><h2>Hugging Face</h2>
<p>@(hfConfigured ? "Access token saved." : "No access token saved.")</p>
<form method="post" action="/settings/huggingface"><AntiforgeryToken />
<label for="hf-token">HF_TOKEN</label><input id="hf-token" type="password" name="token" autocomplete="new-password" placeholder="hf_…" required maxlength="256" />
<button>Save token</button>
</form>
@if(hfConfigured) { <form method="post" action="/settings/huggingface"><AntiforgeryToken /><input type="hidden" name="remove" value="true" /><button class="secondary">Remove token</button></form> }
@if(HfSaved) { <p role="status">Hugging Face token setting saved.</p> }
<p class="secondary-text">Used for model discovery and downloads, including gated models you have permission to access. Reload running model workloads to apply a changed token. The token is never displayed. Recovery backups include it.</p>
</section>
<section class="panel"><h2>Timezone</h2>
@if(timezone!=null) {
    <form method="post" action="/settings/timezone"><AntiforgeryToken />
        <div class="actions"><label class="inline-option"><input type="checkbox" id="timezone-automatic" name="automatic" value="true" checked="@timezone.Automatic" /> Automatic timezone</label><button id="timezone-refresh" type="submit" class="secondary" formaction="/settings/timezone/refresh" disabled="@(!timezone.Automatic)">Refresh</button></div>
        <p class="secondary-text">Automatic uses this server’s public IP via ipwho.is at boot. VPNs can affect the detected location. Current zone: @timezone.Current.</p>
        @if(timezone.Error!=null) { <p role="status">@timezone.Error</p> }
        <label for="timezone">Manual timezone</label>
        <input id="timezone" name="zone" list="timezones" value="@timezone.Current" autocomplete="off" required="@(!timezone.Automatic)" disabled="@timezone.Automatic" />
        <datalist id="timezones">@foreach(var zone in timezone.Zones) { <option value="@zone"></option> }</datalist>
        <button>Save timezone</button>
    </form>
    <script src="/timezone-settings.js" defer></script>
    <p class="secondary-text">Workstations and containers use this setting. Unload and reload running workloads to apply it everywhere.</p>
} else { <p role="alert">Could not read the timezone. <a href="/settings">Refresh</a></p> }
@if(TimezoneSaved) { <p role="status">Timezone saved.</p> }
@if(!string.IsNullOrEmpty(Error)) { <p role="alert">@Error</p> }
</section>
<section class="panel"><h2>Time synchronization</h2>
@if(ntp!=null) {
    <p>NTP: <strong>@(ntp.Active?"Running":"Stopped")</strong> · @(ntp.Synchronized?"Clock synchronized":"Not synchronized yet")</p>
    <form method="post" action="/settings/ntp"><AntiforgeryToken />
        <label class="inline-option"><input type="checkbox" name="enabled" value="true" checked="@ntp.Enabled" /> Enable automatic time synchronization</label>
        <label for="ntp-servers">Preferred NTP servers</label><textarea id="ntp-servers" name="servers" rows="3" placeholder="time.cloudflare.com">@string.Join("\n",ntp.Servers)</textarea>
        <p class="secondary-text">Default: time.cloudflare.com. Enter hostnames or IP addresses, one per line. OS and DHCP time sources remain fallbacks. Leave blank to use those defaults.</p>
        <button>Save NTP settings</button>
    </form>
    @if(NtpSaved) { <p role="status">NTP settings saved. Synchronization may take a few minutes.</p> }
} else { <p role="alert">Could not read NTP settings. <a href="/settings">Refresh</a></p> }
</section>
<section class="panel"><h2>Configuration backup</h2><p>Download a recovery ZIP with the database, settings, accounts, API credentials, network configuration and streaming identities. Includes timestamps, file checksums, permissions and a restore guide.</p><p><strong>Contains passwords and private keys. Store securely.</strong> The ZIP is not encrypted. Download requires HTTPS.</p><a class="button secondary" href="/settings/backup">Download config backup</a><p class="secondary-text">Models, games, home directories and container images/volumes need separate backups. Automatic restore is not available yet.</p></section>
<section class="panel"><h2>IP addresses</h2>
<p><a class="button secondary" href="/settings/network">Manage automatic and static IPs</a></p>
@foreach (var adapter in Device.Network())
{
    <article class="network-adapter" data-interface="@adapter.Name">
        <h3>@adapter.Name <span class="badge">@adapter.State</span></h3>
        <p>@adapter.Kind @(adapter.Kind == "Loopback" ? "· Local to this machine" : "")</p>
        @if (adapter.Addresses.Length == 0) { <p>No addresses assigned.</p> }
        else
        {
            <ul class="ip-addresses">
            @foreach (var address in adapter.Addresses)
            { <li><code>@address</code> <span class="badge">@(address.Contains(':') ? "IPv6" : "IPv4")</span></li> }
            </ul>
        }
    </article>
}
<a class="button secondary" href="/settings">Refresh addresses</a>
</section>
<section class="panel"><h2>Web access</h2>
<p>Open an address reachable from your browser on HTTPS port @(Device.Port+363). This machine uses a persistent self-signed certificate; your browser will ask you to trust it. Link-local IPv6 addresses require the correct interface scope.</p>
@foreach(var url in Device.Urls()) { <p><a href="@url">@url</a></p> }
<p>For remote access with a trusted HTTPS certificate, use <a href="/tailscale">Tailscale Serve</a>.</p>
</section>

@if(!Device.Installer && application!=null) {
<section class="panel" id="update-channel"><h2>Update channel</h2>
<form method="post" action="/application-updates/action" id="update-channel-form"><AntiforgeryToken /><input type="hidden" name="action" value="channel" />
<label for="release-channel">Channel</label><select id="release-channel" name="channel"><option value="stable" selected="@(!application.Development && application.Channel=="stable")">Stable</option><option value="nightly" selected="@(!application.Development && application.Channel=="nightly")">Nightly</option><option value="local" selected="@application.Development">Local build testing</option></select>
<fieldset id="local-update-fields">
<legend>Local build testing</legend>
<label for="local-update-server">Update server</label><input id="local-update-server" name="server" value="@(application.LocalServer ?? (application.Development?application.Server:""))" placeholder="192.0.2.10:8088" maxlength="2048" />
<label for="local-update-key">Signing public key (Ed25519 PEM)</label><textarea id="local-update-key" name="publicKey" rows="4" maxlength="4096" spellcheck="false" placeholder="-----BEGIN PUBLIC KEY-----">@application.PublicKey</textarea>
<p>Paste the contributor’s public key from a trusted source. Builds signed by this key can run privileged code on this computer. Never paste a private key. HTTP or verified HTTPS servers are supported.</p>
</fieldset>
<button disabled="@application.Busy">Save channel</button></form>
<script src="/update-channel.js" defer></script>
<p>Nightly builds come from each main-branch commit after approval. Stable builds come from the release branch. Saving changes the source; install its latest build from Updates. Switching to Stable may install an older compatible version.</p>
<p class="secondary-text">The local server and public key are kept when switching channels. Stable and Nightly always use Xur’s official signing key. All channels verify signatures, file hashes and compatibility.</p>
</section>
}

@code {
    ApplicationUpdateStatus? application;TimezoneStatus? timezone;NtpStatus? ntp;bool hfConfigured;
    [SupplyParameterFromQuery] public bool HfSaved {get;set;}
    [SupplyParameterFromQuery] public bool NtpSaved {get;set;}
    [SupplyParameterFromQuery] public bool TimezoneSaved {get;set;}
    [SupplyParameterFromQuery] public string? Error {get;set;}
    protected override async Task OnInitializedAsync() {if(!Device.Installer)try{application=await Device.Agent.GetFromJsonAsync<ApplicationUpdateStatus>("/application-updates");}catch{}try{hfConfigured=(await Device.Agent.GetFromJsonAsync<System.Text.Json.JsonElement>("/huggingface")).GetProperty("configured").GetBoolean();}catch{}try{timezone=await Device.Agent.GetFromJsonAsync<TimezoneStatus>("/timezone");}catch{}try{ntp=await Device.Agent.GetFromJsonAsync<NtpStatus>("/ntp");}catch{}}
}
