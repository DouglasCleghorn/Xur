@page "/workstations"
@inject Appliance Device
@inject ProfileManager Manager
@inject IHttpContextAccessor Context
<PageTitle>Workstations · Xur</PageTitle>
<HeadContent><link rel="stylesheet" href="/workstations.css" /></HeadContent>
<div class="workstations-page">
<div class="page-heading"><div><h1>Workstations</h1><p class="secondary-text">Your desktops, devices and streaming connections.</p></div><a class="button secondary" href="/profiles">Profiles</a></div>
@if(Saved) { <p class="notice" role="status">Workstation saved.</p> }
@if(DisplaySaved) { <p class="notice" role="status">Virtual display resolution applied.</p> }
@if(Error!=null) { <p class="notice error" role="alert">@Error</p> }
@if(Device.Installer) { <p>Workstations are available after installation.</p> }
else if(stations==null) { <p role="alert">Could not read workstations. <a href="/workstations">Try again</a></p> }
else
{
    <details class="station-create">
        <summary class="button secondary">New workstation</summary>
        <div class="station-create-body">
            <h2>Create a workstation</h2>
            <form class="station-create-form" method="post" action="/workstations/manage">
                <AntiforgeryToken /><input type="hidden" name="action" value="create" />
                <label>Name<input name="name" required maxlength="80" placeholder="My desktop" /></label>
                <label>User<select name="user"><option value="temporary">Temporary user</option>@foreach(var account in users) { <option value="@account.Key">@account.Value</option> }</select></label>
                <button disabled="@busy">Create workstation</button>
            </form>
            <p class="secondary-text">After creating a workstation, add it to a profile to assign its GPU and devices.</p>
            <details class="station-user-create"><summary>Add a user</summary><form class="station-add-user station-inline-form"><AntiforgeryToken /><label>Name<input name="name" required maxlength="60" /></label><button class="secondary" disabled="@busy">Add user</button><p role="status"></p></form></details>
        </div>
    </details>
    @if(!Entries.Any()) { <div class="empty-state"><h2>No workstations yet</h2><p>Create a workstation, then add it to a <a href="/profiles">profile</a> to get started.</p></div> }
    <div class="workstation-list">
    @foreach(var entry in Entries)
    {
        var station=entry.Station;
        var w=station?.Workload;
        var running=station?.State=="running";
        <section class="station-card @(running?"station-running":"")" data-station="@entry.Id" aria-labelledby="station-title-@entry.Id">
            <header class="station-header">
                <div class="station-identity"><h2 id="station-title-@entry.Id">@entry.Name</h2><span class="state-label @(running?"running":"")">@(running?"Running":station?.State??"Not configured")</span></div>
                <div class="station-actions">
                    @if(station!=null && w!=null)
                    {
                        @if(running && station.Stream?.State!="Ready") { <form method="post" action="/workstations/stream"><AntiforgeryToken /><input type="hidden" name="id" value="@w.Id" /><button disabled="@busy">Start streaming</button></form> }
                        <a class="button quiet" href="@("/files?user="+Uri.EscapeDataString(w.User is {Temporary:false}?w.User.Username:(w.User?.Temporary==true?"xurtmp":"xurws")+Canonical.Hash(w.Id)[..12]))">Browse files</a>
                    }
                    else { <a class="button secondary" href="/profiles">Add to a profile</a> }
                </div>
            </header>
            @if(station!=null && w!=null)
            {
                <dl class="station-overview">
                    <div><dt>User</dt><dd>@(w.User?.Temporary==true?"Temporary user":UserLabel(w))</dd></div>
                    <div><dt>GPU</dt><dd>@(station.Gpu?.DisplayName??"GPU unavailable")</dd></div>
                    <div><dt>Display</dt><dd>@(station.Stream?.Headless==true?"Virtual display":station.Gpu?.Displays is {Length:>0}?string.Join(", ",station.Gpu.Displays):"No display connected")</dd></div>
                    <div><dt>@(station.Profiles.Length==1?"Profile":"Profiles")</dt><dd class="station-profile-links">@foreach(var profile in station.Profiles) { <a href="/profiles/edit?id=@profile.Id">@profile.Name</a> }</dd></div>
                </dl>
                @if(allocations.GetValueOrDefault(w.Id) is {} allocation) { @foreach(var problem in allocation.Problems) { <p class="notice error" role="alert">@problem</p> } }
                @if(station.Stream?.Error!=null) { <p class="notice error" role="alert">@station.Stream.Error</p> }
            }
            else { <p class="station-unassigned secondary-text">@DefinitionUser(entry.Definition). Add this workstation to a profile to choose its GPU and devices.</p> }
            <div class="station-tools">
                @if(station!=null && w!=null && running)
                {
            <details class="station-connect station-disclosure"><summary>Connect with Moonlight</summary>
                <ol><li><a href="https://moonlight-stream.org/" target="_blank" rel="noopener noreferrer">Install Moonlight</a> on your client.</li><li>In Moonlight, add <code class="station-address">@StationLauncher.Address(host,station.Stream?.Port??47989)</code> <button type="button" class="quiet copy-station-address">Copy address</button>.</li><li>Select this computer in Moonlight. Enter its PIN below to pair, then choose <strong>Desktop</strong>.</li></ol>
                <p>Streaming encryption is required on every connection. For access outside your LAN, connect both devices through <a href="/tailscale">Tailscale</a> and use Xur's tailnet address.</p>
                @if(secure)
                {
                    <form class="station-pair" data-station="@w.Id"><AntiforgeryToken /><div class="station-client-picker"><label>Client<select name="pairingId" required><option value="">Refresh to find a pairing request</option></select></label><button type="button" class="secondary refresh-pairings">Refresh clients</button></div><div class="pair-fields"><label>PIN<input name="pin" inputmode="numeric" pattern="[0-9]{4}" minlength="4" maxlength="4" autocomplete="off" required /></label><label>Client name<input name="name" maxlength="80" value="Moonlight" required /></label></div><div class="actions"><button disabled="@(station.Stream?.State!="Ready")">Pair client</button></div><p role="status"></p></form>
                }
                else { <p><a href="@https">Open the encrypted manager</a> to pair a client. On your LAN, the browser will ask you to trust this machine's certificate. Tailscale HTTPS also works.</p> }
            </details>

                }
                <details class="station-settings station-disclosure"><summary>Settings</summary>
                    <div class="station-settings-body">
                        @if(entry.Definition!=null)
                        {
                            <form method="post" action="/workstations/manage" class="station-inline-form"><AntiforgeryToken /><input type="hidden" name="action" value="rename" /><input type="hidden" name="id" value="@entry.Id" /><label>Workstation name<input name="name" maxlength="80" value="@entry.Name" required /></label><button class="secondary" disabled="@busy">Save name</button></form>
                            <p class="secondary-text">Names and Moonlight pairing are shared across profiles. Create a new workstation to use a different user.</p>
                        }
                        @if(station!=null && w!=null)
                        {
                            <dl class="station-facts"><dt>Workstation ID</dt><dd>@w.Id</dd><dt>GPU address</dt><dd>@string.Join(", ",w.Gpus)</dd><dt>Streaming</dt><dd>@(station.Stream?.State??"Stopped")</dd>
                            @if(allocations.GetValueOrDefault(w.Id) is {} devices) { <dt>Devices</dt><dd>@devices.Usb.Length USB devices, @devices.Audio.Length audio interfaces@(devices.Primary?" (primary workstation)":"")</dd> }</dl>
                            <div class="actions"><a class="button secondary" href="/api/workloads/@w.Id/logs">Logs</a>@if(running) { <a class="button secondary" href="/api/workstations/@w.Id/graphics" target="_blank" rel="noopener">Graphics report</a> }</div>
            @if(station.Stream?.Headless==true)
            {
                <details><summary>Streaming resolution</summary>
                    <p>When you launch Desktop, the virtual display follows Moonlight's resolution and frame rate. Resuming an existing session keeps its last display mode. After changing Moonlight settings, quit Desktop in Moonlight and launch it again, or apply a mode here.</p>
                    @if(station.State=="running")
                    {
                        <form class="actions" method="post" action="/workstations/display"><AntiforgeryToken /><input type="hidden" name="id" value="@w.Id" />
                            <label>Width<input name="width" type="number" min="320" max="7680" step="2" value="1920" required /></label>
                            <label>Height<input name="height" type="number" min="240" max="4320" step="2" value="1080" required /></label>
                            <label>Refresh rate (Hz)<input name="fps" type="number" min="10" max="240" value="60" required /></label>
                            <button class="secondary" disabled="@busy">Apply resolution</button>
                        </form>
                        <button type="button" class="quiet station-display-details" data-url="/api/workstations/@w.Id/display" data-name="@w.Name" aria-haspopup="dialog">Current display details</button>
                    }
                </details>
            }

                        }
                        @if(entry.Definition!=null)
                        {
                            <div class="station-delete"><form method="post" action="/workstations/manage"><AntiforgeryToken /><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value="@entry.Id" /><button class="secondary danger-text" disabled="@(busy||station!=null)">Delete workstation</button></form><p class="secondary-text">@(station!=null?"Remove this workstation from its profiles and unload it before deleting. User files are kept.":"User files are kept when you delete a workstation.")</p></div>
                        }
                    </div>
                </details>
            </div>
        </section>
    }
    </div>
    <div class="station-help"><details><summary>Game troubleshooting</summary><p>If a Steam game exits or shows a blank screen, set its Launch Options to <code>PROTON_LOG=1 %command%</code>, reproduce once, then remove that option. The log is <code>steam-&lt;appid&gt;.log</code> in this workstation user's home. Review it before sharing.</p><p>The Graphics report checks Vulkan, OpenGL and installed graphics packages using this workstation's device access. On NVIDIA it also runs a short encoder test and includes GPU mapping and active encoder sessions.</p></details></div>
    <dialog id="station-display-dialog" aria-labelledby="station-display-title">
        <div class="section-heading"><h2 id="station-display-title">Current display details</h2><button type="button" class="quiet" id="station-display-close" autofocus>Close</button></div>
        <p id="station-display-name" class="secondary-text"></p>
        <p id="station-display-status" role="status"></p>
        <pre id="station-display-json" tabindex="0" aria-label="Display details JSON" hidden></pre>
        <div class="actions"><button type="button" class="secondary" id="station-display-copy" disabled>Copy JSON</button><a class="button secondary" id="station-display-download" hidden>Download JSON</a><button type="button" class="secondary" id="station-display-retry" hidden>Retry</button></div>
    </dialog>
    <script src="/workstations.js" defer></script>
}
</div>
@code {
    [SupplyParameterFromQuery] public bool Saved {get;set;}
    StationDefinition[] definitions=[];
    [SupplyParameterFromQuery] public bool DisplaySaved {get;set;}
    [SupplyParameterFromQuery] public string? Error {get;set;}
    Dictionary<string,string> users=[];
    Dictionary<string,StationDeviceAllocation> allocations=[];
    string UserLabel(Workload w){var username=w.User?.Username??"xurws"+Canonical.Hash(w.Id)[..12];return users.GetValueOrDefault(username,username);}
    IEnumerable<(string Id,string Name,WorkstationView? Station,StationDefinition? Definition)> Entries =>
        (stations??[]).Select(s=>(s.Workload.Id,s.Workload.Name,(WorkstationView?)s,definitions.FirstOrDefault(d=>d.Id==s.Workload.Id)))
        .Concat(definitions.Where(d=>!(stations??[]).Any(s=>s.Workload.Id==d.Id)).Select(d=>(d.Id,d.Name,(WorkstationView?)null,(StationDefinition?)d)));
    string DefinitionUser(StationDefinition? definition) => definition?.User?.Temporary==true?"Temporary user":users.GetValueOrDefault(definition?.User?.Username??"",definition?.User?.Username??"Existing workstation user");
    WorkstationView[]? stations;bool busy,secure;string host="",https="";
    protected override async Task OnInitializedAsync()
    {
        if(Device.Installer)return;
        var request=Context.HttpContext!.Request;host=request.Host.Host;secure=request.IsHttps||Context.HttpContext.Features.Get<EndpointIdentity>()?.Kind=="serve";
        https="https://"+(host.Contains(':')?"["+host+"]":host)+":"+(Device.Port+363)+"/workstations";
        try{allocations=(await Device.Agent.GetFromJsonAsync<StationDeviceAllocation[]>("/station-allocations")??[]).ToDictionary(a=>a.WorkloadId);}catch{}
        try{definitions=await Manager.Stations();users=(await Device.Agent.GetFromJsonAsync<StationAccount[]>("/station-users")??[]).ToDictionary(u=>u.Username,u=>u.Name);var state=await Manager.State();busy=state.Operation?.Stage is "Applying" or "Cancelling" or "Failed";stations=WorkstationView.Build(state,await Device.Agent.GetFromJsonAsync<StationStreamStatus[]>("/workstations")??[]);}catch{}
    }
}
