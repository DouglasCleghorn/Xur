<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsAotCompatible>true</IsAotCompatible></PropertyGroup>
  <ItemGroup><PackageReference Include="TeeForge" Version="0.1.0" GeneratePathProperty="true" /></ItemGroup>
  <ItemGroup>
    <Content Include="$(PkgTeeForge)/LICENSE" Link="licenses/TeeForge-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgTeeForge)/THIRD-PARTY-NOTICES.txt" Link="licenses/TeeForge-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
